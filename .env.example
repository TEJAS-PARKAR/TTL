# SecureCodeGuard Configuration
# Copy this file to .env and adjust values

# ── Ollama / Local LLM ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# ── Embedding Model ─────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ── ChromaDB ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_CODE=code_chunks
CHROMA_COLLECTION_GUIDELINES=guideline_chunks
CHROMA_COLLECTION_LOGS=log_chunks
CHROMA_COLLECTION_STATIC=static_analysis_chunks
CHROMA_COLLECTION_HISTORICAL=historical_findings

# ── SQLite ───────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/securecodeguard.db

# ── RAG Settings ─────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_TOKENS=2048

# ── Data Paths ───────────────────────────────────────────────────────
DATA_CODE_DIR=./data/code
DATA_GUIDELINES_DIR=./data/guidelines
DATA_LOGS_DIR=./data/logs
DATA_STATIC_DIR=./data/static_analysis
DATA_EVAL_DIR=./data/evaluation
REPORTS_DIR=./reports

# ── Server ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./data/securecodeguard.log

# ── Seed ─────────────────────────────────────────────────────────────
RANDOM_SEED=42
